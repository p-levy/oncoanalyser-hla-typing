// Custom genome configuration for chromosome 6-only reference
// Use this config file with nf-core/oncoanalyser

params {
    genomes {
        'chr6_hg38' {
            fasta         = "/mnt/bioinfnas/immuno/plevy/proj/hlatyping/lilac/alignments/chr6_reference/chr6_only.hg38.fasta"
            fai           = "/mnt/bioinfnas/immuno/plevy/proj/hlatyping/lilac/alignments/chr6_reference/chr6_only.hg38.fasta.fai"
            dict          = "/mnt/bioinfnas/immuno/plevy/proj/hlatyping/lilac/alignments/chr6_reference/chr6_only.hg38.dict"
            img           = "/mnt/bioinfnas/immuno/plevy/proj/hlatyping/lilac/alignments/chr6_reference/chr6_only.hg38.fasta.img"
            bwamem2_index = "/mnt/bioinfnas/immuno/plevy/proj/hlatyping/lilac/alignments/chr6_reference/bwamem2_index/"
        }
    }
    
    
    // Skip genome compatibility checks since we're using a custom chromosome 6 genome
    force_genome = true
    skip_genome_restriction_check = true
    
    // Configuration profile information
    config_profile_description = 'Chromosome 6-only alignment for HLA typing'
    config_profile_contact = 'plevy@vhio.net'
}


// Custom process configuration for chromosome 6-only analysis
process {
    // You might want to reduce memory/CPU requirements since chromosome 6 is much smaller
    withName: '.*:READ_ALIGNMENT_DNA:BWAMEM2_ALIGN' {
        memory = '16.GB'  // Reduced from default since chr6 is smaller
        cpus = 8
        // container = '/mnt/bioinfnas/immuno/plevy/proj/hmftools/singularity/singularity_images/mulled-v2-4dde50190ae599f2bb2027cb2c8763ea00fb5084:544519c4a0ff7e9616a3b44afde1f143c52f10c3-0'
    }
    
    withName: '.*:REDUX_PROCESSING:REDUX' {
        memory = '8.GB'   // Reduced memory for chromosome 6 processing
        cpus = 4
        // container = '/mnt/bioinfnas/immuno/plevy/proj/hmftools/singularity/singularity_images/redux_1.1-rc.3.sif'
    }


	// HLA calling
	withName: 'LILAC' {
		// container = '/mnt/bioinfnas/immuno/plevy/proj/hmftools/singularity/singularity_images/hmftools-lilac:1.7.1--hdfd78af_0'
	}
    
    // General settings
    executor = 'slurm'
    queue = { task.time <= 5.h && task.memory <= 10.GB ? 'short' : (task.time >= 10.d || task.memory < 72.GB ? 'long' : 'highmem') }
    maxRetries = 3
}

executor {
    name = 'slurm'
    queueSize = 10
}

process {
  executor = 'slurm'
  queue = { task.time <= 5.h && task.memory <= 10.GB ? 'short' : (task.time >= 10.d || task.memory < 72.GB ? 'long' : 'highmem') }
  maxRetries = 3
  // Retry on most errors, but ignore exit code 1 (actual tool failures)
  errorStrategy = { task.exitStatus != 1 ? 'retry' : 'ignore' }

    withName: 'BWAMEM2_ALIGN' {
        ext.args3 = "--tmpdir ./"
  }

    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 40.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    withName: /.*REDUX.*/ {
        ext.xmx_mode = '0.70'
  }
}

singularity {
    runOptions = "--bind ${launchDir}/tmp/:/tmp/"
    enabled = true
    autoMounts = true
    // cacheDir = '/mnt/bioinfnas/immuno/plevy/proj/hmftools/singularity/singularity_images/'
    pullTimeout = '120 min'
}