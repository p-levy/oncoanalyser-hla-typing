// Custom genome configuration for chromosome 6-only reference
// Use this config file with nf-core/oncoanalyser

params {
    genomes {
        'chr6_hg38' {
            fasta         = "/mnt/bioinfnas/immuno/plevy/proj/hlatyping/lilac/oncoanalyser-lilac-only/chr6_reference/chr6_only.hg38.fasta"
            fai           = "/mnt/bioinfnas/immuno/plevy/proj/hlatyping/lilac/oncoanalyser-lilac-only/chr6_reference/chr6_only.hg38.fasta.fai"
            dict          = "/mnt/bioinfnas/immuno/plevy/proj/hlatyping/lilac/oncoanalyser-lilac-only/chr6_reference/chr6_only.hg38.dict"
            img           = "/mnt/bioinfnas/immuno/plevy/proj/hlatyping/lilac/oncoanalyser-lilac-only/chr6_reference/chr6_only.hg38.fasta.img"
            bwamem2_index = "/mnt/bioinfnas/immuno/plevy/proj/hlatyping/lilac/oncoanalyser-lilac-only/chr6_reference/bwamem2_index/"
        }
    }
    
    
    // Minimal HMF reference data for alignment, REDUX and LILAC only (see hmf_data_min/)
    // oncoanalyser checks that every hmf_data_paths entry exists, even for processes that don't run;
    // entries set to [] are skipped. Only the 3 entries used by REDUX and LILAC point to real files.
    // Key list matches oncoanalyser 3.0.0 (conf/hmf_data.config); review it when changing -revision.
    hmf_data_paths {
        '38' {
            // Used
            lilac_resources                = 'misc/lilac/'
            msi_jitter_sites               = 'dna/variants/msi_jitter_sites.38.tsv.gz'
            unmap_regions                  = 'common/unmap_regions.38.tsv'
            // Not used by alignment, REDUX or LILAC
            heterozygous_sites             = []
            gc_profile                     = []
            diploid_bed                    = []
            cuppa_alt_sj                   = []
            cuppa_classifier               = []
            decoy_sequences_image          = []
            esvee_pon_breakends_illumina   = []
            esvee_pon_breakpoints_illumina = []
            esvee_pon_breakends_sbx        = []
            esvee_pon_breakpoints_sbx      = []
            esvee_pon_breakends_ultima     = []
            esvee_pon_breakpoints_ultima   = []
            repeatmasker_annotations       = []
            isofox_alt_sj_distribution     = []
            isofox_gene_distribution       = []
            isofox_counts                  = []
            isofox_gc_ratios               = []
            isofox_excluded_regions        = []
            neo_resources                  = []
            cohort_tpm_medians             = []
            peach_haplotypes               = []
            peach_haplotype_functions      = []
            peach_drug_info                = []
            qsee_cohort_percentiles        = []
            disease_ontology               = []
            clinvar_annotations            = []
            sage_blocklist_regions         = []
            sage_blocklist_sites           = []
            sage_highconf_regions          = []
            sage_known_hotspots_germline   = []
            sage_known_hotspots_somatic    = []
            sage_pon_illumina              = []
            sage_pon_ultima                = []
            sage_pon_sbx                   = []
            msi_model_coefficients         = []
            msi_model_error_rates          = []
            sigs_signatures                = []
            virusbreakend_db               = []
            virus_reporting_db             = []
            virus_taxonomy_db              = []
            virus_blocklist_db             = []
            driver_gene_panel              = []
            ensembl_data_resources         = []
            germline_amp_del_freq          = []
            copy_number_percentiles        = []
            gridss_config                  = []
            known_fusion_data              = []
            known_fusions                  = []
            gnomad_resource                = []
            segment_mappability            = []
        }
    }

    // Skip genome compatibility checks since we're using a custom chromosome 6 genome
    force_genome = true
    skip_genome_restriction_check = true
    
    // Configuration profile information
    config_profile_description = 'Chromosome 6-only alignment for HLA typing'
    config_profile_contact = 'plevy@vhio.net'
}


// Custom process configuration for chromosome 6-only analysis
process {
    // You might want to reduce memory/CPU requirements since chromosome 6 is much smaller
    withName: '.*:READ_ALIGNMENT_DNA:BWAMEM2_ALIGN' {
        memory = '16.GB'  // Reduced from default since chr6 is smaller
        cpus = 8
        // container = '/mnt/bioinfnas/immuno/plevy/proj/hmftools/singularity/singularity_images/mulled-v2-4dde50190ae599f2bb2027cb2c8763ea00fb5084:544519c4a0ff7e9616a3b44afde1f143c52f10c3-0'
    }
    
    withName: '.*:REDUX_PROCESSING:REDUX' {
        memory = '8.GB'   // Reduced memory for chromosome 6 processing
        cpus = 4
        // container = '/mnt/bioinfnas/immuno/plevy/proj/hmftools/singularity/singularity_images/redux_1.1-rc.3.sif'
    }


	// HLA calling
	withName: 'LILAC' {
		// container = '/mnt/bioinfnas/immuno/plevy/proj/hmftools/singularity/singularity_images/hmftools-lilac:1.7.1--hdfd78af_0'
	}
    
    // General settings
    executor = 'slurm'
    queue = { task.time <= 5.h && task.memory <= 10.GB ? 'short' : (task.time >= 10.d || task.memory < 72.GB ? 'long' : 'highmem') }
    maxRetries = 3
}

executor {
    name = 'slurm'
    queueSize = 10
}

process {
  executor = 'slurm'
  queue = { task.time <= 5.h && task.memory <= 10.GB ? 'short' : (task.time >= 10.d || task.memory < 72.GB ? 'long' : 'highmem') }
  maxRetries = 3
  // Retry on most errors, but ignore exit code 1 (actual tool failures)
  errorStrategy = { task.exitStatus != 1 ? 'retry' : 'ignore' }

    withName: 'BWAMEM2_ALIGN' {
        ext.args3 = "--tmpdir ./"
  }

    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 40.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    withName: /.*REDUX.*/ {
        ext.xmx_mode = '0.70'
  }
}

singularity {
    runOptions = "--bind ${launchDir}/tmp/:/tmp/"
    enabled = true
    autoMounts = true
    // Optional: shared directory with pre-pulled images (see README step 3); if unset, NXF_SINGULARITY_CACHEDIR or work/singularity/ is used
    // cacheDir = '/mnt/bioinfnas/immuno/plevy/proj/hlatyping/lilac/singularity_images'
    pullTimeout = '120 min'
}

// Small test run on HLA-region reads of the MDA-MB-231 cell line (see test/ and README "Test run")
// Use with -profile singularity,test; --input and --outdir are set by RUN.hla_typing.slurm (test mode).
// outdir can't be set here: oncoanalyser reads it while loading its own config, before -c profiles apply
profiles {
    test {
        process {
            resourceLimits = [cpus: 8, memory: 16.GB, time: 2.h]
        }
    }
}